<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Snuspula — Taste the Unexpected</title>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg: #070707;
      --card: #111111;
      --card2: #171717;
      --text: #f5f5f5;
      --muted: #999;
      --accent: #c8ff00;
      --accent2: #8cff00;
      --border: rgba(255,255,255,.09);
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Inter", sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow-x: hidden;
    }

    /* NAVBAR */

    nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 100;
      padding: 20px 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(7,7,7,.72);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid rgba(255,255,255,.05);
    }

    .logo {
      font-size: 25px;
      font-weight: 900;
      letter-spacing: -1.5px;
    }

    .logo span {
      color: var(--accent);
    }

    nav ul {
      display: flex;
      gap: 32px;
      list-style: none;
    }

    nav a {
      color: #ddd;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      transition: .25s;
    }

    nav a:hover {
      color: var(--accent);
    }

    .nav-pill {
      padding: 10px 18px;
      border: 1px solid var(--accent);
      border-radius: 50px;
      color: var(--accent);
    }

    /* HERO */

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      position: relative;
      padding: 150px 8% 100px;
      overflow: hidden;
    }

    .glow {
      position: absolute;
      width: 600px;
      height: 600px;
      background: var(--accent);
      filter: blur(180px);
      opacity: .08;
      border-radius: 50%;
      right: -200px;
      top: 100px;
    }

    .hero-content {
      max-width: 850px;
      position: relative;
      z-index: 2;
    }

    .eyebrow {
      display: inline-flex;
      padding: 8px 14px;
      border: 1px solid rgba(200,255,0,.3);
      color: var(--accent);
      border-radius: 50px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 25px;
    }

    h1 {
      font-size: clamp(58px, 9vw, 125px);
      line-height: .88;
      letter-spacing: -7px;
      font-weight: 900;
      max-width: 900px;
    }

    h1 span {
      color: var(--accent);
    }

    .hero p {
      color: #aaa;
      max-width: 560px;
      font-size: 18px;
      line-height: 1.7;
      margin: 32px 0;
    }

    .hero-buttons {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
    }

    .button {
      padding: 15px 23px;
      border-radius: 50px;
      text-decoration: none;
      font-size: 14px;
      font-weight: 800;
      transition: .25s;
    }

    .primary {
      background: var(--accent);
      color: #050505;
    }

    .primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 35px rgba(200,255,0,.2);
    }

    .secondary {
      border: 1px solid var(--border);
      color: white;
    }

    .secondary:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    /* MARQUEE */

    .marquee {
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      overflow: hidden;
      white-space: nowrap;
      padding: 17px 0;
      background: #0b0b0b;
    }

    .marquee-track {
      display: inline-block;
      animation: scroll 20s linear infinite;
    }

    .marquee span {
      margin: 0 25px;
      color: #777;
      font-size: 13px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .marquee .green {
      color: var(--accent);
    }

    @keyframes scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    /* FLAVOURS */

    section {
      padding: 110px 7%;
    }

    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: end;
      margin-bottom: 45px;
      gap: 30px;
    }

    .section-heading h2 {
      font-size: clamp(38px, 5vw, 70px);
      letter-spacing: -4px;
      line-height: .95;
    }

    .section-heading p {
      max-width: 400px;
      color: var(--muted);
      line-height: 1.6;
    }

    .flavour-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .flavour {
      min-height: 300px;
      border: 1px solid var(--border);
      background:
        radial-gradient(circle at 80% 20%, rgba(200,255,0,.12), transparent 35%),
        var(--card);
      border-radius: 24px;
      padding: 27px;
      position: relative;
      overflow: hidden;
      transition: .35s;
    }

    .flavour:hover {
      transform: translateY(-7px);
      border-color: rgba(200,255,0,.35);
    }

    .flavour-number {
      font-size: 12px;
      color: #666;
      font-weight: 800;
    }

    .flavour-icon {
      font-size: 60px;
      margin: 35px 0 20px;
    }

    .flavour h3 {
      font-size: 25px;
      letter-spacing: -1px;
    }

    .flavour p {
      color: #888;
      font-size: 13px;
      line-height: 1.5;
      margin-top: 9px;
    }

    .tag {
      position: absolute;
      right: 20px;
      top: 20px;
      padding: 6px 10px;
      border-radius: 20px;
      background: rgba(200,255,0,.1);
      color: var(--accent);
      font-size: 9px;
      font-weight: 800;
      text-transform: uppercase;
    }

    /* FEATURE */

    .feature {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .feature-visual {
      min-height: 500px;
      border-radius: 35px;
      background:
        radial-gradient(circle at 30% 30%, rgba(200,255,0,.22), transparent 25%),
        linear-gradient(145deg, #181818, #080808);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .orb {
      width: 280px;
      height: 280px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #eaff9d, var(--accent), #4b7000);
      box-shadow: 0 0 100px rgba(200,255,0,.2);
      animation: float 5s ease-in-out infinite;
    }

    @keyframes float {
      0%,100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-20px) rotate(8deg); }
    }

    .feature-copy h2 {
      font-size: clamp(40px, 5vw, 70px);
      letter-spacing: -4px;
      line-height: .95;
      margin-bottom: 25px;
    }

    .feature-copy p {
      color: #999;
      line-height: 1.8;
      margin-bottom: 25px;
    }

    .stats {
      display: flex;
      gap: 40px;
    }

    .stat strong {
      display: block;
      color: var(--accent);
      font-size: 30px;
    }

    .stat span {
      color: #666;
      font-size: 11px;
      text-transform: uppercase;
    }

    /* DISCLAIMER */

    .notice {
      margin: 0 7% 100px;
      padding: 25px;
      border: 1px solid rgba(255,255,255,.08);
      background: #0d0d0d;
      border-radius: 18px;
      text-align: center;
    }

    .notice strong {
      color: var(--accent);
      display: block;
      margin-bottom: 8px;
    }

    .notice p {
      color: #777;
      font-size: 12px;
      line-height: 1.6;
    }

    /* FOOTER */

    footer {
      border-top: 1px solid var(--border);
      padding: 45px 7%;
      display: flex;
      justify-content: space-between;
      gap: 30px;
      color: #666;
      font-size: 12px;
    }

    footer .logo {
      color: white;
    }

    /* MOBILE */

    @media(max-width: 850px) {

      nav ul {
        display: none;
      }

      .hero {
        padding-left: 6%;
        padding-right: 6%;
      }

      h1 {
        letter-spacing: -4px;
      }

      .flavour-grid {
        grid-template-columns: 1fr 1fr;
      }

      .feature {
        grid-template-columns: 1fr;
      }

      .section-heading {
        flex-direction: column;
        align-items: start;
      }
    }

    @media(max-width: 550px) {

      section {
        padding: 80px 6%;
      }

      .flavour-grid {
        grid-template-columns: 1fr;
      }

      .feature-visual {
        min-height: 350px;
      }

      .orb {
        width: 200px;
        height: 200px;
      }

      footer {
        flex-direction: column;
      }
    }
  </style>
</head>

